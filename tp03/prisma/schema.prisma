// The schema is the source of truth: it describes the database AND the
// TypeScript types. The two cannot drift apart.

datasource db {
  provider = "sqlite"
}

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

model Organisation {
  id      String  @id @default(uuid())
  slug    String  @unique
  name    String
  country String?

  // The other side of the relation. Not a column: Prisma reads it back
  // through Model.orgId.
  models Model[]
}

model Model {
  id         String  @id
  name       String
  task       String
  parameters Float
  downloads  Int
  license    String?

  // A model belongs to exactly one organisation: the foreign key is
  // required, so there is no such thing as an orphan model.
  orgId        String
  organisation Organisation @relation(fields: [orgId], references: [id])
}
